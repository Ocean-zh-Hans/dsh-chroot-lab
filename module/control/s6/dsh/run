#!/bin/sh
# s6 service: DSH web on loopback. Foreground only; s6 supervises.

exec >/var/log/dsh/dsh.log 2>&1

export HOME=/root
export PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TMPDIR=/tmp
export LANG=C.UTF-8
export TERM=xterm-256color

cd /sdcard/DSH/workspace 2>/dev/null || cd /root || exit 1

if [ ! -x /opt/dsh/current/bin/dsh ]; then
  echo "dsh-run: /opt/dsh/current/bin/dsh missing; install DSH in the rootfs"
  exit 1
fi

exec /opt/dsh/current/bin/dsh web --host 127.0.0.1 --port 0 --no-open
