#!/bin/sh
# s6 service: DSH web on loopback. Foreground only; s6 supervises.

export HOME=/root
export PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TMPDIR=/tmp
export LANG=C.UTF-8
export TERM=xterm-256color

cd /sdcard/DSH/workspace 2>/dev/null || cd /root || exit 1

exec /opt/dsh-control/bin/dsh-run
