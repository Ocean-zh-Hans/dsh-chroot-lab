#!/bin/sh
# s6 service: DSH web on loopback. Foreground only; s6 supervises.

export HOME=/root
export TMPDIR="${DSH_GUEST_TMP:-/var/tmp}"
export LANG=C.UTF-8
export TERM=xterm-256color
. /opt/dsh-control/bin/dsh-android-env || {
  echo 'dsh service: Android environment setup failed' >&2
  exit 1
}

cd "${DSH_WORKSPACE_DIR:-/root/workspace}" || {
  echo 'dsh service: required workspace is unavailable' >&2
  exit 1
}

exec /opt/dsh-control/bin/dsh-run
