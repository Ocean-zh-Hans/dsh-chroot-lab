#!/bin/sh
# Optional ttyd service. Disabled by default via the `down` file.
# Keep loopback-only; do not expose 0.0.0.0.

exec >/var/log/dsh/ttyd.log 2>&1

export HOME=/root
export PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/system/bin:/system/xbin:/vendor/bin:/product/bin:/system_ext/bin:/odm/bin
export TMPDIR=/tmp
export LANG=C.UTF-8

if ! command -v ttyd >/dev/null 2>&1; then
  echo "ttyd-run: ttyd not installed"
  exit 1
fi

exec ttyd -i 127.0.0.1 -p 7681 /bin/bash
