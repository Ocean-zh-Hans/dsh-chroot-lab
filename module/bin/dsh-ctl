#!/system/bin/sh
# shellcheck shell=sh disable=SC3043
# dsh-ctl — module controller (doctor/plan/status + lifecycle).
# Safety: doctor/plan/status are read-only; lifecycle commands require explicit --apply
# for each mount-producing operation.

set -u

DSH_VERSION=${DSH_VERSION:-0.2.2}
DSH_PROG=dsh-ctl

_self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || {
  printf 'dsh-ctl: cannot resolve script directory\n' >&2
  exit 2
}
DSH_MODULE_DIR=${DSH_MODULE_DIR:-$(CDPATH='' cd -- "$_self_dir/.." && pwd)}
LIB_DIR=$DSH_MODULE_DIR/lib

for _lib in common.sh config.sh log.sh proc.sh state.sh lock.sh loop.sh mount.sh doctor.sh plan.sh status.sh lifecycle.sh snapshot.sh systemrw.sh guard.sh ttyd.sh image.sh risk.sh; do
  if [ ! -r "$LIB_DIR/$_lib" ]; then
    printf 'dsh-ctl: missing library: %s\n' "$LIB_DIR/$_lib" >&2
    exit 2
  fi
  # shellcheck disable=SC1090
  . "$LIB_DIR/$_lib"
done

dsh_config_init

dsh_usage() {
  cat <<'EOF'
Usage: dsh-ctl <command> [options]

Read-only:
  doctor [--for-apply]   environment checks
  plan [--check]         print mount/lifecycle plan; never executes
  status [--json]        holder/status check
  config                 resolved paths/knobs
  risk issue|check|status issue a one-time R2/R3/R4 token, dry-run gate, or inspect tokens

Lifecycle (apply is explicit):
  start --apply [--protect-critical=off]
  stop | restart | boot | diag | log [n] | fixperm

Data:
  image create --source DIR [--size 128G] --apply
  image install --source FILE [--sha256 FILE] [--replace] --apply
  snapshot [create [name] [--last-good] | list | restore <name> --apply | promote <name>]
  restore <name> --apply | purge --yes [--keep-image]

Optional:
  autostart status|on|off
  system-rw status|on|off [partition] [--apply]
  guard status|on|off
  ttyd status|on|off
  rescue --apply
  recover --apply

Exit codes:
  0 success
  2 usage error
  3 explicit --apply missing
  4 doctor/apply-readiness or lifecycle failure
EOF
}

if [ "${1:-}" = _lifecycle-claimed ]; then
  [ "${DSH_LIFECYCLE_CLAIM_ACTIVE:-0}" = 1 ] || exit 2
  shift
fi
if [ "${DSH_LIFECYCLE_CLAIM_ACTIVE:-0}" != 1 ]; then
  case ${1:-} in
  start)
    shift
    dsh_risk_gate start "" "${DSH_IMAGE:-}" || exit $?
    dsh_lifecycle_exec "$0" _lifecycle-claimed start "$@"
    _start_rc=$?
    [ "$_start_rc" -ne 0 ] || dsh_watchdog_start_bg || true
    exit "$_start_rc"
    ;;
  stop | restart | boot | recover | rescue | purge | autostart | system-rw | guard | ttyd | snapshot | restore | image | fixperm)
    dsh_risk_gate "${1:-}" "${2:-}" "" || exit $?
    dsh_lifecycle_exec "$0" _lifecycle-claimed "$@"
    exit $?
    ;;
  esac
fi

_cmd=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case $_cmd in
risk)
  dsh_risk_cli "$@"
  exit $?
  ;;
_image-claimed)
  [ "${DSH_IMAGE_CLAIM_ACTIVE:-0}" = 1 ] || exit 2
  _claimed_op=${1:-}
  [ "$#" -gt 0 ] && shift
  case $_claimed_op in
  start) dsh_start "$@" ;;
  rescue) dsh_rescue_claimed "$@" ;;
  snapshot-create) dsh_snapshot_create_claimed "$@" ;;
  snapshot-restore) dsh_snapshot_restore_claimed "$@" ;;
  image-create) dsh_image_create_claimed "$@" ;;
  image-install) dsh_image_install_claimed "$@" ;;
  purge) dsh_purge "$@" ;;
  *) exit 2 ;;
  esac
  ;;
help | -h | --help)
  dsh_usage
  ;;
version | -V | --version)
  printf '%s %s\n' "$DSH_PROG" "$DSH_VERSION"
  ;;
doctor)
  dsh_doctor_run "$@"
  ;;
plan)
  dsh_plan_run "$@"
  ;;
status)
  dsh_status_run "$@"
  ;;
config)
  dsh_config_check_paths || exit 2
  dsh_config_dump
  ;;
start)
  dsh_start "$@"
  ;;
stop)
  dsh_stop
  ;;
restart)
  dsh_restart "$@"
  ;;
boot)
  dsh_boot
  ;;
diag)
  dsh_diag
  ;;
log | logs)
  dsh_logs "$@"
  ;;
fixperm)
  dsh_fixperm
  ;;
autostart)
  dsh_autostart "$@"
  ;;
image)
  _sub=${1:-create}
  if [ "$#" -gt 0 ]; then shift; fi
  case $_sub in
  create) dsh_image_create "$@" ;;
  install) dsh_image_install "$@" ;;
  -h | --help) printf 'Usage: dsh-ctl image create --source DIR [--size 128G] --apply\n       dsh-ctl image install --source FILE [--sha256 FILE] [--replace] --apply\n' ;;
  *)
    dsh_err "unknown image operation: $_sub"
    exit 2
    ;;
  esac
  ;;
snapshot)
  _sub=${1:-create}
  if [ "$#" -gt 0 ]; then shift; fi
  case $_sub in
  create) dsh_snapshot_create "$@" ;;
  list) dsh_snapshot_list ;;
  restore) dsh_snapshot_restore "$@" ;;
  restore-last-good) dsh_snapshot_restore_last_good "$@" ;;
  promote) dsh_snapshot_promote "$@" ;;
  -h | --help) printf 'Usage: dsh-ctl snapshot [create [name] [--last-good]|list|restore <name> --apply|restore-last-good|promote <name>]\n' ;;
  *)
    dsh_err "unknown snapshot operation: $_sub"
    exit 2
    ;;
  esac
  ;;
restore)
  dsh_snapshot_restore "$@"
  ;;
purge)
  dsh_purge "$@"
  ;;
recover)
  dsh_recover "$@"
  ;;
system-rw)
  dsh_system_rw "$@"
  ;;
guard)
  dsh_guard "$@"
  ;;
ttyd)
  dsh_ttyd "$@"
  ;;
rescue)
  dsh_rescue "$@"
  ;;
*)
  printf '%s: unknown command: %s\n' "$DSH_PROG" "$_cmd" >&2
  dsh_usage >&2
  exit 2
  ;;
esac
