#!/system/bin/sh
# shellcheck shell=sh disable=SC3043
# dsh-ctl — module controller (doctor/plan/status + lifecycle).
# Safety: doctor/plan/status are read-only; lifecycle commands require explicit --apply
# for each mount-producing operation.

set -u

DSH_VERSION=${DSH_VERSION:-0.2.0}
DSH_PROG=dsh-ctl

_self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || {
  printf 'dsh-ctl: cannot resolve script directory\n' >&2
  exit 2
}
DSH_MODULE_DIR=${DSH_MODULE_DIR:-$(CDPATH='' cd -- "$_self_dir/.." && pwd)}
LIB_DIR=$DSH_MODULE_DIR/lib

for _lib in common.sh config.sh log.sh proc.sh state.sh lock.sh loop.sh mount.sh doctor.sh plan.sh status.sh lifecycle.sh snapshot.sh systemrw.sh guard.sh image.sh; do
  if [ ! -r "$LIB_DIR/$_lib" ]; then
    printf 'dsh-ctl: missing library: %s\n' "$LIB_DIR/$_lib" >&2
    exit 2
  fi
  # shellcheck disable=SC1090
  . "$LIB_DIR/$_lib"
done

dsh_config_init

dsh_usage() {
  cat <<'EOF'
Usage: dsh-ctl <command> [options]

Read-only:
  doctor [--for-apply]   environment checks
  plan [--check]         print mount/lifecycle plan; never executes
  status [--json]        holder/status check
  config                 resolved paths/knobs

Lifecycle (apply is explicit):
  start --apply [--protect-critical=off] [--permissive]
  stop | restart | boot | diag | log [n] | fixperm

Data:
  image create --source DIR [--size 128G] --apply
  snapshot [create [name] | list | restore <name>]
  restore <name> | purge --yes [--keep-image]

Optional:
  autostart status|on|off
  system-rw status|on|off [partition] [--apply]
  guard status|on|off
  rescue --apply
  recover --apply

Exit codes:
  0 success
  2 usage error
  3 explicit --apply missing
  4 doctor/apply-readiness or lifecycle failure
EOF
}

_cmd=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case $_cmd in
help | -h | --help)
  dsh_usage
  ;;
version | -V | --version)
  printf '%s %s\n' "$DSH_PROG" "$DSH_VERSION"
  ;;
doctor)
  dsh_doctor_run "$@"
  ;;
plan)
  dsh_plan_run "$@"
  ;;
status)
  dsh_status_run "$@"
  ;;
config)
  dsh_config_check_paths || exit 2
  dsh_config_dump
  ;;
start)
  dsh_start "$@"
  ;;
stop)
  dsh_stop
  ;;
restart)
  dsh_restart "$@"
  ;;
boot)
  dsh_boot
  ;;
diag)
  dsh_diag
  ;;
log | logs)
  dsh_logs "$@"
  ;;
fixperm)
  dsh_fixperm
  ;;
autostart)
  dsh_autostart "$@"
  ;;
image)
  _sub=${1:-create}
  if [ "$#" -gt 0 ]; then shift; fi
  case $_sub in
  create) dsh_image_create "$@" ;;
  -h | --help) printf 'Usage: dsh-ctl image create --source DIR [--size 128G] --apply\n' ;;
  *)
    dsh_err "unknown image operation: $_sub"
    exit 2
    ;;
  esac
  ;;
snapshot)
  _sub=${1:-create}
  if [ "$#" -gt 0 ]; then shift; fi
  case $_sub in
  create) dsh_snapshot_create "$@" ;;
  list) dsh_snapshot_list ;;
  restore) dsh_snapshot_restore "$@" ;;
  -h | --help) printf 'Usage: dsh-ctl snapshot [create [name]|list|restore <name>]\n' ;;
  *) dsh_snapshot_create "$_sub" "$@" ;;
  esac
  ;;
restore)
  dsh_snapshot_restore "$@"
  ;;
purge)
  dsh_purge "$@"
  ;;
recover)
  dsh_recover "$@"
  ;;
system-rw)
  dsh_system_rw "$@"
  ;;
guard)
  dsh_guard "$@"
  ;;
rescue)
  dsh_rescue "$@"
  ;;
*)
  printf '%s: unknown command: %s\n' "$DSH_PROG" "$_cmd" >&2
  dsh_usage >&2
  exit 2
  ;;
esac
